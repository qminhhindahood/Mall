      "text": "window.__NUXT__=(function(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v){m.bannerType=c;m.desktop={image:{id:175,url:\"https:\\u002F\\u002F5002121-s3user.vcos.cloudstorage.com.vn\\u002Fjindinrou-prod\\u002Fimage\\u002F2025\\u002F8\\u002F5\\u002F2\\u002FqNa1754362592140.jpeg\"},video:{id:70,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-stg\\u002Ffile\\u002F2020\\u002F7\\u002F31\\u002F10\\u002F4Cj1596192612700.mp4\",masterId:9},slider:{images:[]}};m.mobile={image:{id:182,url:\"https:\\u002F\\u002F5002121-s3user.vcos.cloudstorage.com.vn\\u002Fjindinrou-prod\\u002Fimage\\u002F2025\\u002F8\\u002F5\\u002F3\\u002FaE81754363714557.jpeg\"},video:{id:69,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-stg\\u002Ffile\\u002F2020\\u002F7\\u002F31\\u002F10\\u002Fhtn1596192620561.mp4\",masterId:8},slider:{images:[]}};return {layout:\"default\",data:[{homeData:{id:c,name:f,slugVi:f,slugEn:f,slugJa:f,commonContent:{banner:m,widgets:{reservation:a,social:a,location:a,promotion:{enable:a,uuid:\"ad5d1f8c-63b7-440a-b23138d4-f25c48600a08\"},story:a}},multilangContent:{en:{id:c,content:\"{\\\"story\\\":\\\"\\u003Cp\\u003EIn 1997, at Dunhua North Road Street, Songshan, Taipei City, a master of Xiao Long Bao - “Chen Brothers” are widely recognized around the world for being the founder of the first Jin Din Rou restaurant. &nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003EWith meticulous and delicate processing style together with delightful tastes, especially, with a thin layer of wrapper and special soup in Xiao Long Bao being elaborately processed by an esoteric recipe up to 12 hours, Jin Din Rou quickly conquered diners and became famous.\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003EAfter 26 years, Jin Din Rou continues to maintain the traditional recipes while constantly improving and creating new dishes to reach out to the world with more than 30 stores in Japan. On September 1st, 2023, Jin Din Rou will open the first branch in Vietnam at the 5th floor, Saigon Centre, Ho Chi Minh City.\\u003C\\u002Fp\\u003E\\\"}\"}},createAt:1591686846000,updateAt:1754363716000}}],fetch:{},error:d,state:{isMobileAgent:i,isMobileOrTabletAgent:i,isDisableLogoHeading:i,heading:d,footer:{id:c,status:c,logo:{id:488,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Fimage\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FVCz1595939517686.svg\"},moit:{url:\"#\",icon:{id:58,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Ffile\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FDnT1595939596727.png\"},isActive:j},multilangContent:{en:{id:c,content1:\"JIN DIN ROU CORPORATION\",content2:\"Business Registration Certificate: 0317728951\",content3:\"Address: 180 Pasteur, Sai Gon Ward, HCMC, Vietnam\",content4:\"Hotline: +8428-3933-9999  |  Contact: info@jindinrou.com.vn\"}},footerNavigations:[{id:e,status:c,order:j,multilangContent:{en:{id:e,name:\"Career\",linkType:c,link:\"career\"}}},{id:g,status:c,order:c,multilangContent:{en:{id:g,name:\"Privacy\",linkType:c,link:d}}},{id:h,status:c,order:2,multilangContent:{en:{id:h,name:\"Terms of Service\",linkType:c,link:d}}},{id:n,status:c,order:e,multilangContent:{en:{id:n,name:\"Contact\",linkType:c,link:d}}}]},widgets:{story:{id:c,name:\"story\",commonContent:{image:{id:499,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Fimage\\u002F2020\\u002F7\\u002F31\\u002F9\\u002Faaj1596188663806.svg\"}},multilangContent:{en:{id:c,content:\"{\\\"text\\\":\\\"\\u003Cp\\u003EEasy to find a salad anywhere, but &nbsp;you may know that Thai's salad (Papaya Salads) is on the top 50 salad worth trying in the world. Thai Cusine has its own way with their own recipe and especially the way to combine many sophisticated and complex but subtle spices for highly-seasoned, tasty