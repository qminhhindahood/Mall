      "text": "window.__NUXT__=(function(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y){o.bannerType=c;o.desktop={image:{id:142,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fasanoha-prod\\u002Fimage\\u002F2025\\u002F4\\u002F10\\u002F3\\u002FeJH1744256222688.jpeg\"},video:{id:70,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-stg\\u002Ffile\\u002F2020\\u002F7\\u002F31\\u002F10\\u002F4Cj1596192612700.mp4\",masterId:p},slider:{images:[]}};o.mobile={image:{id:143,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fasanoha-prod\\u002Fimage\\u002F2025\\u002F4\\u002F10\\u002F3\\u002Fq7X1744256230014.jpeg\"},video:{id:69,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-stg\\u002Ffile\\u002F2020\\u002F7\\u002F31\\u002F10\\u002Fhtn1596192620561.mp4\",masterId:q},slider:{images:[]}};return {layout:\"default\",data:[{homeData:{id:c,name:h,slugVi:h,slugEn:h,slugJa:h,commonContent:{banner:o,widgets:{reservation:a,social:a,location:a,promotion:{enable:a,uuid:\"ad5d1f8c-63b7-440a-b23138d4-f25c48600a08\"},story:a}},multilangContent:{vi:{id:c,content:\"{\\\"text\\\":\\\"\\u003Cp\\u003E\\\\\\\"Ở đâu cũng có gỏi, nhưng ngon đến mức lọt vào danh sách 50 món đáng thử nhất thế giới, thì chỉ có ở Thái Lan. Ẩm thực Thái Lan với cách chế biến riêng và đặc biệt cách ứng dụng nhiều gia vị cầu kỳ, phức tạp nhưng cũng rất tinh tế cho hương vị đậm đà, đầy đủ, cân bằng, đậm chất riêng luôn được yêu thích khắp thế giới, nhất là khi hương vị đạt đúng chuẩn Thái từ gia vị đến cách chế biến. Được chia làm bốn vùng miền: Bắc, Đông Bắc, Trung Thổ và miền Nam. Phong cách chế biến truyền thống theo từng vùng miền tạo ra nền ẩm thực Thái nhiều màu sắc từ hương đến vị.\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003ETại Som ตำ Thai, dưới bàn tay của các đầu bếp người Thái giàu kinh nghiệm, công thức nấu ăn được truyền nối, gia vị chính gốc nhập khẩu từ Thái kết hợp với nguyên liệu tươi ngon tại địa phương tạo nên hương vị chuẩn Thái.\\\\\\\"\\u003C\\u002Fp\\u003E\\\",\\\"story\\\":\\\"\\u003Cp\\u003EVới tiêu chí mang đến lẩu ngon từ nguyên liệu, sức khoẻ vẹn toàn và đẹp từ bên trong, Asanoha là mô hình lẩu Nhật Bản hiện đại giúp tăng cường sức khoẻ, hỗ trợ đề kháng, khoẻ người, đẹp da và giữ dáng.&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003EBí mật nằm trong chính nước lẩu và các loại nấm thượng hạng, bằng phương pháp Mizutaki tinh chế ra 8 loại nước dùng đặc biệt và nguồn nấm tươi được nuôi trồng tại nông trại Sachi Farm của Asanoha.\\u003C\\u002Fp\\u003E\\\"}\"}},createAt:1591686846000,updateAt:1744256236000}}],fetch:{},error:d,state:{isMobileAgent:i,isMobileOrTabletAgent:i,isDisableLogoHeading:i,heading:d,footer:{id:c,status:c,logo:{id:488,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Fimage\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FVCz1595939517686.svg\"},moit:{url:\"#\",icon:{id:58,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Ffile\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FDnT1595939596727.png\"},isActive:j},multilangContent:{vi:{id:c,content1:\"CÔNG TY CỔ PHẦN TAKAHIRO\",content2:\"Giấy Phép đăng ký kinh doanh số: 0315827587\",content3:\"Địa chỉ: 180 Pasteur, Phường Sài Gòn, Thành phố Hồ Chí Minh, Việt Nam\",content4:\"Điện thoại: +8428-3933-9999 | Liên hệ: asanoha@asanoha.com.vn\"}},footerNavigations:[{id:e,status:c,order:j,multilangContent:{vi:{id:e,name:\"Tuyển dụng\",linkType:c,link:\"career\"}}},{id:g,status:c,order:c,multilangContent:{vi:{id:g,name:\"Chính sách bảo mật\",linkType:c,link:d}}},{id:f,status:c,order:r,multilangContent:{vi:{id:f,name:\"Điều khoản\",linkType:c,link:d}}},{id:k,status:c,order:e,multilangContent:{vi:{id:k,name:\"Liên hệ\",linkType:c,link:d}}}]},widgets:{story:{id:c,name:\"story\",commonContent:{image:{id:499,url:\"https:\\u002F\\u002F5002121-s3us