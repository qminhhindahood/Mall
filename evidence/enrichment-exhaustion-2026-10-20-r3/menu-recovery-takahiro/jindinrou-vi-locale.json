\u002F2\\u002FqNa1754362592140.jpeg\"},video:{id:70,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-stg\\u002Ffile\\u002F2020\\u002F7\\u002F31\\u002F10\\u002F4Cj1596192612700.mp4\",masterId:9},slider:{images:[]}};n.mobile={image:{id:182,url:\"https:\\u002F\\u002F5002121-s3user.vcos.cloudstorage.com.vn\\u002Fjindinrou-prod\\u002Fimage\\u002F2025\\u002F8\\u002F5\\u002F3\\u002FaE81754363714557.jpeg\"},video:{id:69,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-stg\\u002Ffile\\u002F2020\\u002F7\\u002F31\\u002F10\\u002Fhtn1596192620561.mp4\",masterId:8},slider:{images:[]}};return {layout:\"default\",data:[{homeData:{id:c,name:f,slugVi:f,slugEn:f,slugJa:f,commonContent:{banner:n,widgets:{reservation:a,social:a,location:a,promotion:{enable:a,uuid:\"ad5d1f8c-63b7-440a-b23138d4-f25c48600a08\"},story:a}},multilangContent:{vi:{id:c,content:\"{\\\"text\\\":\\\"\\u003Cp\\u003E\\\\\\\"Ở đâu cũng có gỏi, nhưng ngon đến mức lọt vào danh sách 50 món đáng thử nhất thế giới, thì chỉ có ở Thái Lan. Ẩm thực Thái Lan với cách chế biến riêng và đặc biệt cách ứng dụng nhiều gia vị cầu kỳ, phức tạp nhưng cũng rất tinh tế cho hương vị đậm đà, đầy đủ, cân bằng, đậm chất riêng luôn được yêu thích khắp thế giới, nhất là khi hương vị đạt đúng chuẩn Thái từ gia vị đến cách chế biến. Được chia làm bốn vùng miền: Bắc, Đông Bắc, Trung Thổ và miền Nam. Phong cách chế biến truyền thống theo từng vùng miền tạo ra nền ẩm thực Thái nhiều màu sắc từ hương đến vị.\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003ETại Som ตำ Thai, dưới bàn tay của các đầu bếp người Thái giàu kinh nghiệm, công thức nấu ăn được truyền nối, gia vị chính gốc nhập khẩu từ Thái kết hợp với nguyên liệu tươi ngon tại địa phương tạo nên hương vị chuẩn Thái.\\\\\\\"\\u003C\\u002Fp\\u003E\\\",\\\"story\\\":\\\"\\u003Cp\\u003ENăm 1997, tại con đường Dunhua North Road, Songshan, thành phố Đài Bắc, bậc thầy Xiao Long Bao 'Anh em nhà Chen' được công nhận và biết đến rộng rãi trên khắp thế giới đã sáng lập nhà hàng Jin Din Rou đầu tiên.\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003EVới phong cách chế biến tỉ mỉ và tinh tế cùng hương vị thơm ngon, đặc biệt, lớp áo bánh mỏng và nước súp trong Xiao Long Bao (Tiểu Long Bao) được chế biến cầu kỳ bằng công thức bí truyền với thời gian lên đến 12 tiếng, Jin Din Rou nhanh chóng chinh phục thực khách và trở nên nổi tiếng.\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003ESau 26 năm, Jin Din Rou vẫn liên tục giữ vững công thức truyền thống đồng thời không ngừng hoàn thiện, sáng tạo thêm các món mới và phát triển mạnh mẽ vượt khỏi biên giới với hơn 35 cửa hàng tại Nhật Bản.\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003ENgày 01\\u002F09\\u002F2023, Jin Din Rou chính thức khai trương chi nhánh đầu tiên tại Việt Nam tại lầu 5 Saigon Centre, TP. HCM.\\u003C\\u002Fp\\u003E\\\"}\"}},createAt:1591686846000,updateAt:1754363716000}}],fetch:{},error:d,state:{isMobileAgent:i,isMobileOrTabletAgent:i,isDisableLogoHeading:i,heading:d,footer:{id:c,status:c,logo:{id:488,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Fimage\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FVCz1595939517686.svg\"},moit:{url:\"#\",icon:{id:58,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Ffile\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FDnT1595939596727.png\"},isActive:j},multilangContent:{vi:{id:c,content1:\"CÔNG TY CỔ PHẦN JIN DIN ROU\",content2:\"Giấy Phép đăng ký kinh doanh số: 0317728951\",content3:\"Địa chỉ: 180 Pasteur, Phường Sài Gòn,Thành phố Hồ Chí Minh, Việt Nam\",content4:\"Điện thoại: +8428-3933-9999  |  Liên hệ: info@jindinrou.com.vn\"}},footerNavigations:[{id:e,status:c,order:j,multilangContent:{vi:{id:e,name:\"Tuyển dụng\",linkType:c,link:\"career\"}}},{id:g,status:c,order:c,multilangContent:{vi:{i