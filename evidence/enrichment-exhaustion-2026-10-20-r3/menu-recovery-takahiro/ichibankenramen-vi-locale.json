 Thái kết hợp với nguyên liệu tươi ngon tại địa phương tạo nên hương vị chuẩn Thái.\\\\\\\"\\u003C\\u002Fp\\u003E\\\",\\\"story\\\":\\\"\\u003Cp\\u003ERAMEN ICHIBANKEN là chuỗi cửa hàng mì Ramen nổi tiếng có nguồn gốc từ Nagoya với gần 30 chi nhánh khắp Nhật Bản đã chính thức có mặt tại Việt Nam.\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003ECâu chuyện về nước dùng Tonkotsu đặc sắc nhất của Ramen Ichibanken sẽ được nối tiếp trong hành trình chinh phục khẩu vị khách Việt, và cả khách hàng người Nhật tại Việt Nam về một món ăn đặc trưng mang đậm hương vị bản địa\\u003C\\u002Fp\\u003E\\\"}\"}},createAt:1591686846000,updateAt:1767172656000}}],fetch:{},error:b,state:{isMobileAgent:g,isMobileOrTabletAgent:g,isDisableLogoHeading:g,heading:b,footer:{id:a,status:a,logo:{id:488,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Fimage\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FVCz1595939517686.svg\"},moit:{url:\"#\",icon:{id:58,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Ffile\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FDnT1595939596727.png\"},isActive:h},multilangContent:{vi:{id:a,content1:\"CÔNG TY CỔ PHẦN TAKAHIRO\",content2:\"Giấy Phép đăng ký kinh doanh số: 0315827587\",content3:\"Địa chỉ: 180 Pasteur, Phường Sài Gòn, Thành phố Hồ Chí Minh, Việt Nam\",content4:\"Điện thoại: +8428-3933-9999 | Liên hệ: info@takahiro.com.vn\"}},footerNavigations:[{id:f,status:a,order:h,multilangContent:{vi:{id:f,name:\"Tuyển dụng\",linkType:a,link:\"career\"}}},{id:e,status:a,order:a,multilangContent:{vi:{id:e,name:\"Chính sách bảo mật\",linkType:a,link:b}}},{id:c,status:a,order:r,multilangContent:{vi:{id:c,name:\"Điều khoản\",linkType:a,link:b}}},{id:i,status:a,order:f,multilangContent:{vi:{id:i,name:\"Liên hệ\",linkType:a,link:b}}}]},widgets:{story:{id:a,name:\"story\",commonContent:{image:{id:499,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u0