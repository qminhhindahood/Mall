do-sachi-prod\\u002Fimage\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FVCz1595939517686.svg\"},moit:{url:\"#\",icon:{id:58,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Ffile\\u002F2020\\u002F7\\u002F28\\u002F12\\u002FDnT1595939596727.png\"},isActive:j},multilangContent:{en:{id:c,content1:\"TAKAHIRO CORPORATION\",content2:\"Business Registration Certificate: 0315827587\",content3:\"Address: 180 Pasteur, Sai Gon Ward, HCMC, Vietnam\",content4:\"Hotline: +8428-3933-9999  |  Contact: asanoha@asanoha.com.vn\"}},footerNavigations:[{id:e,status:c,order:j,multilangContent:{en:{id:e,name:\"Career\",linkType:c,link:\"career\"}}},{id:g,status:c,order:c,multilangContent:{en:{id:g,name:\"Privacy\",linkType:c,link:d}}},{id:f,status:c,order:q,multilangContent:{en:{id:f,name:\"Terms of Service\",linkType:c,link:d}}},{id:k,status:c,order:e,multilangContent:{en:{id:k,name:\"Contact\",linkType:c,link:d}}}]},widgets:{story:{id:c,name:\"story\",commonContent:{image:{id:499,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fhokkaido-sachi-prod\\u002Fimage\\u002F2020\\u002F7\\u002F31\\u002F9\\u002Faaj1596188663806.svg\"}},multilangContent:{en:{id:c,content:\"{\\\"text\\\":\\\"\\u003Cp\\u003EEasy to find a salad anywhere, but &nbsp;you may know that Thai's salad (Papaya Salads) is on the top 50 salad worth trying in the world. Thai Cusine has its own way with their own recipe and especially the way to combine many sophisticated and complex but subtle spices for highly-seasoned, tasty, balanced, unique flavor that is always loved around the world, specially authentic Thai from spice to. Thai cusine has 4 traditional styles from 4 regions of Thai: North, Eastern North, the Midland and South creating a colorful Thai cuisine from the tastes to the flavors.\\u003C\\u002Fp\\u003E\\u003Cp\\u003E&nbsp;\\u003C\\u002Fp\\u003E\\u003Cp\\u003EIn Som ตำ Thai, food is cooked by Thai Head Chef has a wealth of experience, hereditary recipient, the original marinade imported from Thai and the sources of fresh ingredients in local all of which &nbsp;have created authentic Thai flavor.\\u003C\\u002Fp\\u003E\\\"}\"}},createAt:1591776524000,updateAt:1652691499000},reservation:{id:e,name:r,commonContent:{selectedLocations:[f,g],name:r,content:[{uuid:\"b68733ec-9f74-49dd-a71db075-93ebf13ac54f\",link:b,active:a,multilangContent:{vi:{name:\"Đồng Khởi\",link:b,active:a},en:{name:s,active:a,link:b},ja:{name:s,active:a,link:b}},name:\"Tiếng việt\"},{uuid:\"44086038-39fa-427b-8dcb8552-06ed6f776060\",link:b,active:a,multilangContent:{vi:{name:l,link:b,active:a},en:{name:l,link:b,active:a},ja:{name:l,link:b,active:a}}},{uuid:\"63db697a-d7ed-4758-aa963c12-703cda0ef831\",link:b,active:a,multilangContent:{vi:{name:\"Nguyễn Đình Chiểu\",link:b,active:a},en:{name:\" Nguyen Dinh Chieu\",link:b,active:a},ja:{name:\"Nguyen Dinh Chieu\",link:b,active:a}}},{uuid:\"876c457b-151a-4df6-ad4c6cd1-be139dd33fcb\",link:b,active:a,multilangContent:{vi:{name:\"Đông Du\",link:b,active:a},en:{name:t,link:b,active:a},ja:{name:t,link:b,active:a}}},{uuid:\"ea981997-fdb0-4bc9-88c003dd-d4b9fada0af5\",link:b,active:a,multilangContent:{vi:{name:\"Nguyễn Trãi\",link:b,active:a},en:{name:u,link:b,active:a},ja:{name:u,link:b,active:a}}},{uuid:\"4c952d94-432d-4064-af91b2a1-df182dcd1389\",link:b,active:a,multilangContent:{vi:{name:\"Phan Xích Long\",link:b,active:a},en:{name:v,link:b,active:a},ja:{name:v,link:b}}}]},multilangContent:{en:{id:e,content:m}},createAt:1591778751000,updateAt:1721148403000},social:{id:f,name:w,commonContent:{name:w,content:[{uuid:\"73cbb6a2-b08b-4463-a8e77fc1-3781b45cd885\",icon:{id:11,url:\"https:\\u002F\\u002F5002121-s3user.s3.cloudstorage.com.vn\\u002Fasanoha-prod\\u002Ffile\\u002F2024\\u002F01\\u002F22\\u002F03\\u002Fev81705894216436.svg\"},title:\"Instagram\",link:\"https:\\u002F\\u002Fwww.instagram.com\\u002Fasanohavn\\u002F\",active:a},{uuid:\"0e41cd20-c807-4f4d-aa8b2c9a-1d50f99e25e5\",icon:{id:12,url:\"https:\\u002