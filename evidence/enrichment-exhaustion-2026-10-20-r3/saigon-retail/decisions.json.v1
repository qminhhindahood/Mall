      "sources": [
        {
          "url": "https://www.nihontoki.com/default.aspx?page=7",
          "evidenceFile": "source-002.txt",
          "reference": "turn264search0",
          "title": "Nihon Toki masterpieces of Japan ceramics and pottery (https://www.nihontoki.com/default.aspx?page=7)",
          "section": "actual product listing / collection catalogue",
          "result": "indexed official text retrieved",
          "support": "Nihon Toki masterpieces of Japan ceramics and pottery Gốm sứ nghệ thuật Nhật Bản là một trong những loại đồ gốm sứ đẹp nhất và tinh xảo nhất trên thế giới NIHON TOKI - Cửa hàng gốm sứ nghệ thuật Nhật Bản cao cấp Các sản phẩm gốm sứ nghệ thuật tại cửa hàng được nhập khẩu trực tiếp từ Nhật Bản, của các thương hiệu truyền thống nổi tiếng lâu đời: Kutani, Yakushigama, Ryukodo, Craftman,... Các tác phẩm được chế tác thủ công tinh xảo, chất lượng đỉnh cao, toát lên vẻ đẹp độc đáo và quyến rũ có một không hai. Mọi công đoạn chế tác đều được lựa chọn kỹ lưỡng và giám sát cẩn thận vẹn toàn để đảm bảo mỗi sản phẩm đều đẹp và có chất lượng cao nhất. Từ khâu khai thác ủ lọc, đãi lấy phần tinh ba của đất sét, cho đến các kỹ nghệ chế tác và nung hầm. Với bàn tay tài hoa hiếm có, với tâm hồn siêu cảm, và sự vận dụng hỏa biến thiên tạo diệu kỳ, người nghệ nhân Nhật Bản đã chế tác nên những tác phẩm gốm sứ tuyệt mỹ có nước men lộng tạo hình sống động có hồn. Tinh hoa nghề gốm sứ được truyền tử lưu tôn, nối tiếp bao thế hệ và được sáng tạo không ngừng. Vẻ đẹp vượt thời gian, kiểu dáng độc đáo, màu sắc tự nhiên, tạo nên không gian tuyệt vời cho bất kỳ phong cách trang trí nào trong ngôi nhà, cửa tiệm, văn phòng của bạn. Đồ gốm Nhật Bản không chỉ mang giá trị thẩm mỹ mà còn giàu ý nghĩa văn hóa và triết học sâu sắc, là biểu tượng của sự may mắn, bình an, và những giá trị truyền thống của đất nước Nhật Bản hùng cường, thịnh vượng. Thương hiệu gốm thủ công Kutani Nhật Bản đã có hơn 360 năm lịch sử, từ thời Edo. Nằm dưới chân núi Hakusan hùng vĩ là chín thung lũng bình yên, với những dòng sông êm"
        }
      ],
