---
import {site} from '../../data/site';
import {atlasRouting} from '../../data/atlas-routing';
import JourneyAtlas from '../../components/JourneyAtlas';
---
<!doctype html><html lang="en" data-mall={site.mallId}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Directions · {site.name}</title></head><body><JourneyAtlas site={site} routing={atlasRouting} locale="en" publicDirections client:load/><noscript>Choose a starting point with JavaScript enabled to check reviewed routes. <a href="/en?view=discovery">Open the mall directory and floor maps</a>.</noscript></body></html>
