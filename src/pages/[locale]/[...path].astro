---
import Guide from '../../layouts/Guide.astro';
import Explorer from '../../components/Explorer';
import { site, clientSite } from '../../data/site';
import { copy } from '../../components/copy';
import type { Locale, SceneKind } from '../../runtime/scene-contract';
import FloorMap from '../../components/FloorMap';
export function getStaticPaths() {
  return ['vi','en'].flatMap(locale=>[
    {params:{locale,path:undefined},props:{floorId:site.defaultFloor,kind:'exterior'}},
    ...site.geometry.floors.map(floor=>({params:{locale,path:`${locale==='vi'?'tang':'floors'}/${floor.id}`},props:{floorId:floor.id,kind:'map'}})),
    ...site.destinations.map(destination=>({params:{locale,path:`${locale==='vi'?'cua-hang':'stores'}/${destination.id}`},props:{floorId:destination.primaryFloor,kind:'map',destinationId:destination.id}})),
    {params:{locale,path:'404'},props:{notFound:true}},
  ]);
}
const locale = Astro.params.locale as Locale;
const { floorId=site.defaultFloor,kind='exterior',destinationId,notFound } = Astro.props as {floorId?:string;kind?:SceneKind;destinationId?:string;notFound?:boolean};
const floor = site.geometry.floors.find(item=>item.id===floorId)!;
const staticFloors = destinationId ? site.geometry.floors.filter(item=>site.destinations.find(destination=>destination.id===destinationId)?.floors.includes(item.id)) : [floor];
---
<Guide locale={locale} title={`${site.name} · ${copy[locale].guide}`}>
  {notFound ? <main><h1>{copy[locale].missing}</h1><p>{site.name}</p><a href={`/${locale}`}>{copy[locale].home}</a></main> : <><Explorer site={clientSite} initial={{locale,floorId,kind,destinationId}} client:load /><section class="static-guide">{staticFloors.map(item=><><h2><a href={`/${locale}/${locale==='vi'?'tang':'floors'}/${item.id}`}>{copy[locale].map} · {item.label}</a></h2><FloorMap floor={item} title={copy[locale].map} /></>)}<p>{copy[locale].uncertainty}</p></section></>}
</Guide>
